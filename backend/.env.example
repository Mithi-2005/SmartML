# MongoDB connection string
MONGO_DB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Automl

# JWT secret (change in production!)
JWT_SECRET=supersecret

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.netlify.app

# Azure Blob Storage Configuration (Optional: Backend falls back to local disk if connection string is empty)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=smartml-storage

